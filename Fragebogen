<script>
const STORAGE_KEY='dessarin-held-v1';
const IS_EXPORTED=false;

function fields(){
  return [...document.querySelectorAll('[data-key]')];
}
function persist(){
  const data={};
  fields().forEach(el=>{
    if(el.type==='radio'){
      if(el.checked) data[el.dataset.key]=el.value;
    }else if(el.type==='checkbox'){
      data[el.dataset.key]=el.checked;
    }else{
      data[el.dataset.key]=el.value;
    }
  });
  localStorage.setItem(STORAGE_KEY,JSON.stringify(data));
  const s=document.getElementById('status');
  if(s) s.textContent='Gespeichert – '+new Date().toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});
}
function restore(){
  if(IS_EXPORTED) return;
  try{
    const data=JSON.parse(localStorage.getItem(STORAGE_KEY)||'{}');
    fields().forEach(el=>{
      if(data[el.dataset.key]===undefined) return;
      if(el.type==='radio') el.checked=(el.value===data[el.dataset.key]);
      else if(el.type==='checkbox') el.checked=!!data[el.dataset.key];
      else el.value=data[el.dataset.key];
    });
    document.getElementById('currentDR').textContent=new Date().getFullYear()-530;
    updateBirthAge(); updateHeight(); updateWeight();
    if(Object.keys(data).length){
      document.getElementById('status').textContent='Gespeicherte Antworten geladen.';
    }
  }catch(e){}
}
function toggleHelp(btn){
  const box=btn.closest('.question').querySelector('.helpbox');
  document.querySelectorAll('.helpbox.open').forEach(x=>{if(x!==box)x.classList.remove('open')});
  box.classList.toggle('open');
}
document.addEventListener('click',e=>{
  if(!e.target.closest('.question')) document.querySelectorAll('.helpbox.open').forEach(x=>x.classList.remove('open'));
});
function updateBirthAge(){
  const input=document.getElementById('birthDate');
  const result=document.getElementById('birthResult');
  const currentDR=new Date().getFullYear()-530;
  document.getElementById('currentDR').textContent=currentDR;
  const value=input.value.trim();
  if(!value){result.textContent='Aktuelles Alter: –';return;}
  const m=value.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})\s*(?:DR)?$/i);
  if(!m){result.textContent='Bitte als TT.MM.JJJJ DR eingeben.';return;}
  const day=+m[1], month=+m[2], birthDR=+m[3];
  const now=new Date();
  let age=currentDR-birthDR;
  if(month>now.getMonth()+1 || (month===now.getMonth()+1 && day>now.getDate())) age--;
  if(age<0 || month<1 || month>12 || day<1 || day>31){
    result.textContent='Bitte ein gültiges Geburtsdatum eingeben.';return;
  }
  result.textContent=`Aktuelles Alter: ${age} Jahre`;
}
function updateHeight(){
  const value=document.getElementById('height').value.trim().replace(',','.');
  const out=document.getElementById('heightImperial');
  const m=value.match(/(\d+(?:\.\d+)?)\s*m?/i);
  if(!m){out.textContent='–';return;}
  const cm=+m[1]*100;
  if(!Number.isFinite(cm)||cm<30||cm>300){out.textContent='–';return;}
  const total=cm/2.54;
  const feet=Math.floor(total/12);
  let inches=Math.round(total-feet*12);
  if(inches===12){out.textContent=`${feet+1}' 0"`;}else out.textContent=`${feet}' ${inches}"`;
}
function updateWeight(){
  const value=document.getElementById('weight').value.trim().replace(',','.');
  const out=document.getElementById('weightImperial');
  const m=value.match(/(\d+(?:\.\d+)?)\s*(?:kg)?/i);
  if(!m){out.textContent='–';return;}
  const kg=+m[1];
  if(!Number.isFinite(kg)||kg<=0||kg>1000){out.textContent='–';return;}
  out.textContent=`${Math.round(kg*2.2046226218)} lb`;
}
function saveFile(){
  persist();

  const nameField=document.querySelector('[data-key="name"]');
  const discordField=document.querySelector('[data-key="discord"]');
  const characterName=(nameField?.value||'Charakter').trim()
    .replace(/[^a-zA-Z0-9äöüÄÖÜß _-]/g,'')
    .replace(/\s+/g,'_') || 'Charakter';
  const discordName=(discordField?.value||'Spieler').trim()
    .replace(/[^a-zA-Z0-9äöüÄÖÜß _-]/g,'')
    .replace(/\s+/g,'_') || 'Spieler';

  const clone=document.documentElement.cloneNode(true);

  // Embed the current values directly into the HTML.
  const sourceFields=fields();
  const clonedFields=[...clone.querySelectorAll('[data-key]')];

  sourceFields.forEach((source,index)=>{
    const target=clonedFields[index];
    if(!target)return;

    if(source.type==='radio' || source.type==='checkbox'){
      if(source.checked) target.setAttribute('checked','checked');
      else target.removeAttribute('checked');
    }else{
      target.setAttribute('value',source.value);
      if(target.tagName.toLowerCase()==='textarea') target.textContent=source.value;
    }
  });

  // Keep calculated display values visible in the saved copy.
  const currentDR=clone.querySelector('#currentDR');
  const birthResult=clone.querySelector('#birthResult');
  const heightImperial=clone.querySelector('#heightImperial');
  const weightImperial=clone.querySelector('#weightImperial');

  if(currentDR) currentDR.textContent=document.getElementById('currentDR').textContent;
  if(birthResult) birthResult.textContent=document.getElementById('birthResult').textContent;
  if(heightImperial) heightImperial.textContent=document.getElementById('heightImperial').textContent;
  if(weightImperial) weightImperial.textContent=document.getElementById('weightImperial').textContent;

  // Mark the exported document so it does not overwrite the embedded answers
  // with whatever happens to be stored in the browser where it is opened.
  clone.querySelectorAll('script').forEach(script=>{
    if(script.textContent.includes("const IS_EXPORTED=false;")){
      script.textContent=script.textContent.replace(
        "const IS_EXPORTED=false;",
        "const IS_EXPORTED=true;"
      );
    }
  });

  // Update the status in the exported copy.
  const status=clone.querySelector('#status');
  if(status) status.textContent='Ausgefüllte Version gespeichert.';

  const html='<!doctype html>\n'+clone.outerHTML;
  const blob=new Blob([html],{type:'text/html;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=discordName+'_'+characterName+'.html';
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function resetForm(){
  if(!confirm('Wirklich alle Antworten in diesem Browser löschen?')) return;
  fields().forEach(el=>{if(el.type==='checkbox'||el.type==='radio')el.checked=false;else el.value=''});
  localStorage.removeItem(STORAGE_KEY);
  updateBirthAge();updateHeight();updateWeight();
  document.getElementById('status').textContent='Antworten gelöscht.';
}
fields().forEach(el=>el.addEventListener('input',persist));
document.getElementById('birthDate').addEventListener('input',updateBirthAge);
document.getElementById('height').addEventListener('input',updateHeight);
document.getElementById('weight').addEventListener('input',updateWeight);
document.querySelectorAll('input[type=checkbox],input[type=radio]').forEach(el=>el.addEventListener('change',persist));
restore();
</script>
